# AetherScan .gitignore
# ======================

# Claude Code config
.claude/

# Environment files (NEVER commit secrets)
.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
ENV/
backend/venv/

# Node.js / Frontend
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js
frontend/.next/
frontend/out/
.next/

# Build artifacts
*.tsbuildinfo
.turbo/

# Large data files (download separately for full functionality)
# WorldPop raster files (1.4 GB)
backend/cache/data/worldpop/*.tif

# WorldClim raster files (11 GB)
backend/cache/data/worldclim/*.tif

# Large UN census file (143 MB)
backend/cache/data/census/WPP2024_GEN_F01_DEMOGRAPHIC_INDICATORS_FULL.xlsx

# Generated/cached data
backend/cache/tiles/
backend/cache/*.db
backend/*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/
backend/startup.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
nul

# Temporary files
*.tmp
*.temp
*.bak

# Test artifacts
.coverage
htmlcov/
.pytest_cache/
.tox/
.nox/

# Documentation build
docs/_build/
site/

# Jupyter
.ipynb_checkpoints/

# Keep these data files (essential for core functionality, <50MB each)
!backend/cache/data/census/A-1_NO_OF_VILLAGES_TOWNS_HOUSEHOLDS_POPULATION_AND_AREA.xlsx
!backend/cache/data/power_plants/global_power_plant_database.csv
!backend/cache/data/.gitkeep
!backend/cache/.gitkeep
