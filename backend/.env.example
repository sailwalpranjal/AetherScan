# AetherScan Backend — Environment Variables
# Copy to .env and fill in your values.
# ==========================================

# OpenAQ v3  (https://openaq.org/ — free tier)
OPENAQ_API_KEY=your_openaq_api_key_here
OPENAQ_API_URL=https://api.openaq.org/v3

# NASA FIRMS WMS Map Key (https://firms.modaps.eosdis.nasa.gov/api/area/)
NASA_FIRMS_API_KEY=your_nasa_firms_map_key_here
NASA_FIRMS_URL=https://firms.modaps.eosdis.nasa.gov

# NASA Earthdata Bearer Token (https://urs.earthdata.nasa.gov/)
NASA_EARTHDATA_TOKEN=your_earthdata_jwt_token_here

# Copernicus Data Space Ecosystem — Sentinel Hub OAuth2
# Register at https://shapps.dataspace.copernicus.eu/dashboard/
CDSE_CLIENT_ID=your_cdse_client_id_here
CDSE_CLIENT_SECRET=your_cdse_client_secret_here
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_STAC_URL=https://catalogue.dataspace.copernicus.eu/stac

# data.gov.in API (https://data.gov.in/ — register for free key)
OGD_INDIA_API_KEY=your_datagov_india_api_key_here
OGD_INDIA_URL=https://api.data.gov.in/resource

# AQICN (https://aqicn.org/data-platform/token/ — free)
AQICN_API_TOKEN=your_aqicn_token_here

# OpenWeather (https://openweathermap.org/api — free tier)
OPENWEATHER_API_KEY=your_openweather_key_here

# Optional: Mapbox (https://account.mapbox.com/)
MAPBOX_TOKEN=your_mapbox_token_here

# Database (SQLite for local dev, set DATABASE_URL for Postgres on Render/Supabase)
DATABASE_PATH=./cache/aetherscan.db
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/aetherscan

# Cache
TILE_CACHE_DIR=./cache/tiles
DATA_CACHE_DIR=./cache/data
CACHE_EXPIRY_HOURS=24

# API Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
