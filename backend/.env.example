# AetherScan Backend Environment Variables
# Copy this file to .env and fill in your API keys
# =================================================

# OpenAQ API Key (Required for air quality data)
# Get FREE key from: https://openaq.org/
OPENAQ_API_KEY=your_openaq_api_key_here

# NASA FIRMS API Key (Required for fire detection data)
# Get FREE key from: https://firms.modaps.eosdis.nasa.gov/api/area/
NASA_FIRMS_API_KEY=your_nasa_firms_api_key_here

# NASA Earthdata API Key (For satellite data)
# Get FREE key from: https://urs.earthdata.nasa.gov/
NASA_EARTHDATA_API_KEY=your_nasa_earthdata_api_key_here

# OpenWeather API Key (For weather and climate data)
# Get FREE key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# AQICN API Token (For air quality index data)
# Get FREE token from: https://aqicn.org/data-platform/token/
AQICN_API_TOKEN=your_aqicn_token_here

# Optional: Mapbox token for enhanced maps
# Get from: https://account.mapbox.com/
MAPBOX_TOKEN=your_mapbox_token_here

# Database
DATABASE_PATH=./cache/aetherscan.db

# Cache settings
TILE_CACHE_DIR=./cache/tiles
DATA_CACHE_DIR=./cache/data
CACHE_EXPIRY_HOURS=24

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# CORS Origins (comma-separated)
# Add your Vercel frontend URL after deployment
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
